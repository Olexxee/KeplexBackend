generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. USER & AUTH
// ==========================================

model User {
  id        String     @id @default(cuid())
  fullName  String
  email     String     @unique
  phone     String?
  password  String
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  addresses               Address[]
  auditLogs               AuditLog[]
  carts                   Cart[]
  orders                  Order[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  refreshTokens           RefreshToken[]
  wishlists               Wishlist[]
  reviews                 Review[]
  reviewResponses         ReviewResponse[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String?
  fullName    String
  phone       String
  addressLine String
  city        String
  state       String?
  country     String   @default("NG")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model NotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  orderEmails       Boolean  @default(true)
  orderStatusEmails Boolean  @default(true)
  trainingEmails    Boolean  @default(true)
  marketingEmails   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

// ==========================================
// 2. CATALOG
// ==========================================

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  type        CategoryType @default(PRODUCT)
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  parentId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  parent   Category?       @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[]      @relation("CategoryChildren")
  products Product[]
  media    CategoryMedia[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
}

model CategoryMedia {
  id         String   @id @default(cuid())
  categoryId String
  url        String
  publicId   String   @unique
  mimeType   String?
  width      Int?
  height     Int?
  bytes      Int?
  format     String?
  alt        String?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([isPrimary])
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
  media    BrandMedia[]

  @@index([slug])
  @@index([isActive])
}

model BrandMedia {
  id        String   @id @default(cuid())
  brandId   String
  url       String
  publicId  String   @unique
  mimeType  String?
  width     Int?
  height    Int?
  bytes     Int?
  format    String?
  alt       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([isPrimary])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
  @@index([isActive])
}

model Product {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  brandId      String?
  categoryId   String
  collectionId String?
  isFeatured   Boolean       @default(false)
  isNew        Boolean       @default(false)
  isBestSeller Boolean       @default(false)
  status       ProductStatus @default(DRAFT)
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  brand      Brand?           @relation(fields: [brandId], references: [id])
  category   Category         @relation(fields: [categoryId], references: [id])
  collection Collection?      @relation(fields: [collectionId], references: [id])
  variants   ProductVariant[]
  wishlists  Wishlist[]

  @@index([categoryId])
  @@index([brandId])
  @@index([collectionId])
  @@index([slug])
  @@index([status])
}

model ProductVariant {
  id              String          @id @default(cuid())
  productId       String
  sku             String          @unique
  color           String?
  size            String?
  weight          Decimal         @db.Decimal(8, 2)
  price           Decimal         @db.Decimal(12, 2)
  compareAtPrice  Decimal?        @db.Decimal(12, 2)
  stock           Int             @default(0)
  fulfillmentType FulfillmentType @default(LOCAL)
  length          Decimal?        @db.Decimal(8, 2)
  width           Decimal?        @db.Decimal(8, 2)
  height          Decimal?        @db.Decimal(8, 2)
  actualWeight    Decimal         @db.Decimal(8, 2)
  shippingType    ShippingMethod  @default(LOCAL)
  isActive        Boolean         @default(true)
  attributes      Json?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  media            VariantMedia[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reviews          Review[]
  fulfillmentItems FulfillmentItem[]

  @@index([productId])
  @@index([sku])
  @@index([isActive])
}

model VariantMedia {
  id        String   @id @default(cuid())
  variantId String
  url       String
  publicId  String   @unique
  mimeType  String?
  width     Int?
  height    Int?
  bytes     Int?
  format    String?
  alt       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([isPrimary])
}

// ==========================================
// 3. CART
// ==========================================

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  variantId         String
  quantity          Int
  unitPriceSnapshot Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
}

// ==========================================
// 4. ORDER
// ==========================================

model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique
  userId      String?

  customerName  String
  customerEmail String?
  customerPhone String?

  shippingLabel   String?
  shippingStreet  String?
  shippingCity    String?
  shippingState   String?
  shippingCountry String?

  subtotal     Decimal @db.Decimal(12, 2)
  shippingCost Decimal @default(0) @db.Decimal(12, 2)
  taxAmount    Decimal @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal @db.Decimal(12, 2)

  cbm              Decimal?  @db.Decimal(12, 4)
  chargeableWeight Decimal?  @db.Decimal(12, 2)
  cbmData          Json?
  cbmUpdatedAt     DateTime?
  cbmUpdatedBy     String?

  status            OrderStatus @default(PENDING)
  notes             String?
  fulfillmentGroups Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  items        OrderItem[]
  payments     Payment[]
  fulfillments Fulfillment[]
  reviews      Review[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  variantId         String
  quantity          Int
  unitPriceSnapshot Decimal  @db.Decimal(12, 2)
  totalPrice        Decimal  @db.Decimal(12, 2)
  cbm               Decimal? @db.Decimal(12, 4)
  chargeableWeight  Decimal? @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([variantId])
}

model Payment {
id                   String        @id @default(cuid())
orderId              String?
trainingEnrollmentId String?
paymentType          PaymentType   @default(ORDER_PAYMENT)
provider             String        @default("PAYSTACK")
reference            String        @unique
providerReference    String?       @unique
amount               Decimal       @db.Decimal(12, 2)
currency             String        @default("NGN")
status               PaymentStatus @default(PENDING)
authorizationUrl     String?
accessCode           String?
providerPayload      Json?
createdAt            DateTime      @default(now())
updatedAt            DateTime      @updatedAt

order              Order?              @relation(fields: [orderId], references: [id], onDelete: Cascade)
trainingEnrollment TrainingEnrollment? @relation(fields: [trainingEnrollmentId], references: [id], onDelete: Cascade)

@@index([orderId])
@@index([reference])
@@index([providerReference])
@@index([trainingEnrollmentId])
}


enum PaymentType {
  ORDER_PAYMENT
  TRAINING_REGISTRATION
}

// ==========================================
// 5. FULFILLMENT & WAREHOUSE
// ==========================================

model Fulfillment {
  id                String            @id @default(cuid())
  orderId           String
  type              FulfillmentType   @default(LOCAL)
  warehouseId       String?
  status            FulfillmentStatus @default(PENDING)
  trackingNumber    String?
  carrier           String?
  trackingUrl       String?
  estimatedDelivery DateTime?
  shippingCost      Decimal           @default(0) @db.Decimal(12, 2)
  deliveredAt       DateTime?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse Warehouse?        @relation(fields: [warehouseId], references: [id])
  items     FulfillmentItem[]

  @@index([orderId])
  @@index([warehouseId])
  @@index([status])
  @@index([type])
}

model FulfillmentItem {
  id            String   @id @default(cuid())
  fulfillmentId String
  variantId     String
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  fulfillment Fulfillment    @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([fulfillmentId])
  @@index([variantId])
}

model Warehouse {
  id        String        @id @default(cuid())
  name      String
  code      String        @unique
  type      WarehouseType @default(LOCAL)
  address   String?
  city      String?
  state     String?
  country   String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  fulfillments Fulfillment[]

  @@index([type])
  @@index([isActive])
}

// ==========================================
// 6. SHIPPING CONFIGURATION
// ==========================================

model ShippingConfiguration {
  id     String                      @id @default(cuid())
  name   String
  status ShippingConfigurationStatus @default(ACTIVE)

  pricePerKg            Decimal  @default(0)
  pricePerCBM           Decimal  @default(0)
  handlingFee           Decimal  @default(0)
  minCharge             Decimal  @default(0)
  freeShippingThreshold Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules ShippingRule[]

  @@index([status])
}

model ShippingRule {
  id       String           @id @default(cuid())
  name     String
  type     ShippingRuleType @default(DEFAULT)
  isActive Boolean          @default(true)

  minSubtotal Decimal?
  maxSubtotal Decimal?
  minWeight   Decimal?
  maxWeight   Decimal?

  baseRate   Decimal @default(0)
  ratePerKg  Decimal @default(0)
  ratePerCBM Decimal @default(0)
  priority   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  configurationId String
  configuration   ShippingConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@index([configurationId])
  @@index([isActive])
  @@index([type])
  @@index([priority])
}

// ==========================================
// 7. TRAINING
// ==========================================

model TrainingProgram {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  shortDescription String?
  description      String?
  price            Decimal  @db.Decimal(12, 2)
  featured         Boolean  @default(false)
  active           Boolean  @default(true)
  displayOrder     Int      @default(0)
  highlights       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  media       TrainingMedia[]
  enrollments TrainingEnrollment[]

  @@index([slug])
  @@index([active])
}

model TrainingMedia {
  id                String   @id @default(cuid())
  trainingProgramId String
  url               String
  publicId          String
  mimeType          String
  bytes             Int
  format            String?
  width             Int?
  height            Int?
  order             Int      @default(0)
  isMain            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trainingProgram TrainingProgram @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)

  @@index([trainingProgramId])
}

model TrainingEnrollment {
  id                String             @id @default(cuid())
  trainingProgramId String
  fullName          String
  email             String
  phone             String
  amount            Decimal            @db.Decimal(12, 2)
  status            RegistrationStatus @default(PENDING)
  paymentRef        String?            @unique
  authorizationUrl  String?
  accessCode        String?
  provider          String             @default("PAYSTACK")
  providerPayload   Json?
  paidAt            DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  trainingProgram TrainingProgram @relation(fields: [trainingProgramId], references: [id])
  payments        Payment[]

  @@unique([trainingProgramId, email])
  @@index([status])
  @@index([trainingProgramId])
}

// ==========================================
// 8. WISHLIST, REVIEW, TESTIMONIAL
// ==========================================

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Review {
  id              String       @id @default(cuid())
  userId          String
  variantId       String
  orderId         String?
  rating          Int          @default(5)
  title           String?
  comment         String?
  isVerified      Boolean      @default(false)
  status          ReviewStatus @default(PENDING)
  helpfulCount    Int          @default(0)
  notHelpfulCount Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order     Order?         @relation(fields: [orderId], references: [id])
  images    ReviewImage[]
  responses ReviewResponse[]

  @@unique([userId, variantId])
  @@index([userId])
  @@index([variantId])
  @@index([status])
  @@index([orderId])
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  url       String
  publicId  String
  mimeType  String?
  bytes     Int?
  format    String?
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([reviewId, sortOrder])
}

model ReviewResponse {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  comment   String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([reviewId])
}

model Testimonial {
  id        String            @id @default(cuid())
  name      String
  role      String?
  message   String
  rating    Int               @default(5)
  imageUrl  String?
  status    TestimonialStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ==========================================
// 9. SYSTEM & CONFIG
// ==========================================

model Organisation {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  email       String?
  phone       String?
  logoUrl     String?
  address     String?
  socialLinks Json?
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model BusinessConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model ArchiveRecord {
  id            String   @id @default(cuid())
  entityType    String   // "PRODUCT" | "VARIANT"
  entityId      String
  snapshot      Json
  reason        String?
  archivedBy    String?
  archivedAt    DateTime @default(now())
  restoreUntil  DateTime
  restoredAt    DateTime?
  hardDeletedAt DateTime?

  @@unique([entityType, entityId])
  @@index([entityType, archivedAt])
  @@index([restoreUntil])
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CategoryType {
  PRODUCT
  SERVICE
  CONTENT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  LOCAL
  IMPORT
  PREORDER
  DIGITAL
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShippingMethod {
  LOCAL
  IMPORT
  SEA
  AIR
  DIGITAL
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REVERSED
}

enum WarehouseType {
  LOCAL
  IMPORT
  PREORDER
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShippingRuleType {
  DEFAULT
  LOCAL
  IMPORT
  SEA
  AIR
  DIGITAL
}

enum ShippingConfigurationStatus {
  ACTIVE
  INACTIVE
}
