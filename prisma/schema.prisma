generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER & AUTH MODELS
// ==========================================

model User {
  id                      String                   @id @default(cuid())
  fullName                String
  email                   String                   @unique
  phone                   String?
  password                String
  role                    UserRole                 @default(CUSTOMER)
  status                  UserStatus               @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  addresses               Address[]
  auditLogs               AuditLog[]
  carts                   Cart[]
  orders                  Order[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  refreshTokens           RefreshToken[]
  wishlists               Wishlist[]
  reviews                 Review[]
  reviewResponses         ReviewResponse[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String?
  fullName    String
  phone       String
  addressLine String
  city        String
  state       String?
  country     String   @default("NG")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// CATALOG MODELS
// ==========================================

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  type        CategoryType @default(PRODUCT)
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  parentId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  parent   Category?       @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[]      @relation("CategoryChildren")
  products Product[]
  media    CategoryMedia[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
}

model CategoryMedia {
  id         String @id @default(cuid())
  categoryId String

  url       String
  publicId  String  @unique
  mimeType  String?
  width     Int?
  height    Int?
  bytes     Int?
  format    String?
  alt       String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([isPrimary])
}

model Product {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  brandId      String?
  categoryId   String
  collectionId String?
  isFeatured   Boolean       @default(false)
  isNew        Boolean       @default(false)
  isBestSeller Boolean       @default(false)
  status       ProductStatus @default(DRAFT)
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  brand      Brand?           @relation(fields: [brandId], references: [id])
  category   Category         @relation(fields: [categoryId], references: [id])
  collection Collection?      @relation(fields: [collectionId], references: [id])
  variants   ProductVariant[]

  @@index([categoryId])
  @@index([brandId])
  @@index([collectionId])
  @@index([slug])
  @@index([status])
}

model ProductVariant {
  id              String          @id @default(cuid())
  productId       String
  sku             String          @unique
  color           String?
  size            String?
  weight          Decimal         @db.Decimal(8, 2)
  price           Decimal         @db.Decimal(12, 2)
  compareAtPrice  Decimal?        @db.Decimal(12, 2)
  stock           Int             @default(0)
  fulfillmentType FulfillmentType @default(LOCAL)
  length          Decimal?        @db.Decimal(8, 2)
  width           Decimal?        @db.Decimal(8, 2)
  height          Decimal?        @db.Decimal(8, 2)
  actualWeight    Decimal         @db.Decimal(8, 2)
  shippingType    ShippingMethod  @default(LOCAL)
  isActive        Boolean         @default(true)
  attributes      Json?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  media            VariantMedia[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  wishlists        Wishlist[]
  reviews          Review[]
  fulfillmentItems FulfillmentItem[]

  @@index([productId])
  @@index([sku])
  @@index([isActive])
}

model VariantMedia {
  id        String   @id @default(cuid())
  variantId String
  url       String
  publicId  String   @unique
  mimeType  String?
  width     Int?
  height    Int?
  bytes     Int?
  format    String?
  alt       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([isPrimary])
}

model Brand {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    Product[]
  media       BrandMedia[]

  @@index([slug])
  @@index([isActive])
}

model BrandMedia {
  id      String @id @default(cuid())
  brandId String

  url       String
  publicId  String  @unique
  mimeType  String?
  width     Int?
  height    Int?
  bytes     Int?
  format    String?
  alt       String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([isPrimary])
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
  @@index([isActive])
}

// ==========================================
// CART & ORDER MODELS
// ==========================================

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[] // ← leave Cart exactly as-is, no variant field here

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  variantId         String
  quantity          Int
  unitPriceSnapshot Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade) // ← only this line changes

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique
  userId      String?

  // Customer info
  customerName  String
  customerEmail String?
  customerPhone String?

  // Shipping info
  shippingLabel   String?
  shippingStreet  String?
  shippingCity    String?
  shippingState   String?
  shippingCountry String?

  // Financials
  subtotal     Decimal @db.Decimal(12, 2)
  shippingCost Decimal @default(0) @db.Decimal(12, 2)
  taxAmount    Decimal @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal @db.Decimal(12, 2)

  // CBM Data
  cbm              Decimal?  @db.Decimal(12, 4)
  chargeableWeight Decimal?  @db.Decimal(12, 2)
  cbmData          Json?
  cbmUpdatedAt     DateTime?
  cbmUpdatedBy     String?

  // Order data
  status            OrderStatus @default(PENDING)
  notes             String?
  fulfillmentGroups Json?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User?         @relation(fields: [userId], references: [id])
  items        OrderItem[]
  payments     Payment[]
  fulfillments Fulfillment[]
  reviews      Review[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  variantId         String
  quantity          Int
  unitPriceSnapshot Decimal  @db.Decimal(12, 2)
  totalPrice        Decimal  @db.Decimal(12, 2)
  cbm               Decimal? @db.Decimal(12, 4)
  chargeableWeight  Decimal? @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  provider         String        @default("PAYSTACK")
  reference        String        @unique
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("NGN")
  status           PaymentStatus @default(PENDING)
  authorizationUrl String?
  accessCode       String?
  providerPayload  Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([reference])
}

// ==========================================
// FULFILLMENT MODELS
// ==========================================

model Fulfillment {
  id                String            @id @default(cuid())
  orderId           String
  type              FulfillmentType   @default(LOCAL)
  warehouseId       String?
  status            FulfillmentStatus @default(PENDING)
  trackingNumber    String?
  carrier           String?
  trackingUrl       String?
  estimatedDelivery DateTime?
  shippingCost      Decimal           @default(0) @db.Decimal(12, 2)
  deliveredAt       DateTime?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse Warehouse?        @relation(fields: [warehouseId], references: [id])
  items     FulfillmentItem[]

  @@index([orderId])
  @@index([warehouseId])
  @@index([status])
  @@index([type])
}

model FulfillmentItem {
  id            String   @id @default(cuid())
  fulfillmentId String
  variantId     String
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  // Relations
  fulfillment Fulfillment    @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([fulfillmentId])
  @@index([variantId])
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String
  city      String
  state     String
  country   String   @default("NG")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  fulfillments Fulfillment[]

  @@index([code])
  @@index([isActive])
}

// ==========================================
// TRAINING MODELS
// ==========================================

model TrainingProgram {
  id               String               @id @default(cuid())
  title            String
  slug             String               @unique
  shortDescription String?
  description      String?
  price            Decimal              @db.Decimal(12, 2)
  featured         Boolean              @default(false)
  active           Boolean              @default(true)
  displayOrder     Int                  @default(0)
  highlights       Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  media            TrainingMedia[]
  enrollments      TrainingEnrollment[]

  @@index([slug])
  @@index([active])
}

model TrainingMedia {
  id                String          @id @default(cuid())
  trainingProgramId String
  trainingProgram   TrainingProgram @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)
  url               String
  publicId          String
  mimeType          String
  bytes             Int
  format            String?
  width             Int?
  height            Int?
  order             Int             @default(0)
  isMain            Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([trainingProgramId])
}

model TrainingEnrollment {
  id                String             @id @default(cuid())
  trainingProgramId String
  fullName          String
  email             String
  phone             String
  amount            Decimal            @db.Decimal(12, 2)
  status            RegistrationStatus @default(PENDING)
  paymentRef        String?            @unique
  authorizationUrl  String?
  accessCode        String?
  provider          String             @default("PAYSTACK")
  providerPayload   Json?
  paidAt            DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  trainingProgram   TrainingProgram    @relation(fields: [trainingProgramId], references: [id])

  @@unique([trainingProgramId, email])
  @@index([status])
  @@index([trainingProgramId])
}

// ==========================================
// SOCIAL, WISHLIST & REVIEW MODELS
// ==========================================

model Wishlist {
  id        String         @id @default(cuid())
  userId    String
  variantId String
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([userId])
  @@index([variantId])
}

model Review {
  id              String           @id @default(cuid())
  userId          String
  variantId       String
  orderId         String?
  rating          Int              @default(5)
  title           String?
  comment         String?
  images          Json?
  isVerified      Boolean          @default(false)
  status          ReviewStatus     @default(PENDING)
  helpfulCount    Int              @default(0)
  notHelpfulCount Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant         ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order           Order?           @relation(fields: [orderId], references: [id])
  responses       ReviewResponse[]

  @@index([userId])
  @@index([variantId])
  @@index([status])
}

model ReviewResponse {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  comment   String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([reviewId])
}

model Testimonial {
  id        String            @id @default(cuid())
  name      String
  role      String?
  message   String
  rating    Int               @default(5)
  imageUrl  String?
  status    TestimonialStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ==========================================
// SYSTEM & CONFIG MODELS
// ==========================================

model Organisation {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  email       String?
  phone       String?
  logoUrl     String?
  address     String?
  socialLinks Json?
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model BusinessConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model NotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  orderEmails       Boolean  @default(true)
  orderStatusEmails Boolean  @default(true)
  trainingEmails    Boolean  @default(true)
  marketingEmails   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CategoryType {
  PRODUCT
  SERVICE
  CONTENT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  LOCAL
  IMPORT
  PREORDER
  DIGITAL
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShippingMethod {
  LOCAL
  IMPORT
  SEA
  AIR
  DIGITAL
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REVERSED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}
