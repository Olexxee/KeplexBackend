            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Nike Air Max 2024\",\n    \"slug\": \"nike-air-max-2024\",\n    \"description\": \"The latest Nike Air Max with superior comfort and style.\",\n    \"categoryId\": \"{{categoryId}}\",\n    \"brandId\": \"{{brandId}}\",\n    \"collectionId\": \"{{collectionId}}\",\n    \"isFeatured\": true,\n    \"isNew\": true,\n    \"isBestSeller\": false,\n    \"status\": \"ACTIVE\",\n    \"variants\": [\n        {\n            \"sku\": \"NIKE-AM-BLK-42\",\n            \"color\": \"Black\",\n            \"size\": \"42\",\n            \"price\": 25000,\n            \"compareAtPrice\": 30000,\n            \"stock\": 50,\n            \"weight\": 0.5,\n            \"actualWeight\": 0.5,\n            \"fulfillmentType\": \"LOCAL\",\n            \"shippingType\": \"LOCAL\",\n            \"length\": 30,\n            \"width\": 20,\n            \"height\": 10,\n            \"isActive\": true\n        },\n        {\n            \"sku\": \"NIKE-AM-BLK-43\",\n            \"color\": \"Black\",\n            \"size\": \"43\",\n            \"price\": 25000,\n            \"compareAtPrice\": 30000,\n            \"stock\": 30,\n            \"weight\": 0.5,\n            \"actualWeight\": 0.5,\n            \"fulfillmentType\": \"LOCAL\",\n            \"shippingType\": \"LOCAL\",\n            \"length\": 30,\n            \"width\": 20,\n            \"height\": 10,\n            \"isActive\": true\n        }\n    ]\n}"
